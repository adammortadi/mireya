generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("CUSTOMER") // ADMIN or CUSTOMER
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String
  price            Float
  stock            Int      @default(0)
  isBestSeller     Boolean  @default(false)
  isPersonalizable Boolean  @default(false)
  emoji            String?
  handwrittenTitle String?
  bgColor          String?
  
  images           String   // JSON serialized array of URLs
  
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  orderItems       OrderItem[]
}

model Order {
  id         String      @id @default(cuid())
  userId     String?     // null for guest checkout
  status     String      @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED
  total      Float
  customer   String      // JSON serialized customer info (name, email, address)
  items      OrderItem[]
  createdAt  DateTime    @default(now())
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float   // Price at time of purchase
}
